{
  "manifest_version": 3,
  "name": "BitTab — Nova Guia",
  "version": "1.0.0",
  "description": "Substitui a Nova Guia do navegador pelo BitTab: relógio, busca, atalhos e widgets.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "BitTab",
    "default_popup": "options.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bittab@bit01tec.dev",
      "strict_min_version": "115.0"
    }
  }
}
